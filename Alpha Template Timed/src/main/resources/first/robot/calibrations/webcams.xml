<!--
  Camera calibrations, keyed by USB (vid, pid) and capture resolution.

  Each <Camera> is identified by its numeric USB vendor id (vid) and product id (pid).
  Each <Calibration> gives the intrinsics for one capture resolution:
    size           (int pair):   width height
    focalLength    (float pair): fx fy   (pixels)
    principalPoint (float pair): cx cy   (pixels)

  Values and separators are forgiving: a trailing 'f' and either spaces or commas
  between the two numbers are both accepted (e.g. "821.993f, 821.993f").

  Loaded at runtime by WebcamCalibrations; matched against UsbCamera.getInfo().
-->
<Calibrations>

    <!-- ======================================================================================= -->

    <!-- Microsoft Lifecam HD 3000 v1, Calibrated by PTC using unknown tooling -->
    <Camera vid="0x045E" pid="0x0779">
        <Calibration
            size="640 480"
            focalLength="678.154f, 678.17f"
            principalPoint="318.135f, 228.374f"
            />
    </Camera>

    <!-- ======================================================================================= -->

